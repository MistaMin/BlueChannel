# Reference material (third-party schematics, manuals and the reference SPICE model) stays out of the repository.
/*-model/
build/
dist/
.DS_Store
*.swp
__pycache__/

# Private engineering inputs and original reference documents must never be published.
/.private/

# QA run transients and bulky media (docs stay: report.md/json, ledger.md, exceptions.txt, logs)
qa/**/cmd.txt
qa/**/resp.txt
qa/**/ready.txt
qa/**/seq.txt
qa/**/reaper.pid
qa/**/hider.pid
qa/**/suite.pid
qa/**/startup_backup.txt
qa/**/*.wav
qa/**/*.png
qa/**/*.ppm
qa/**/*.rpp
qa/**/*.reapeaks
